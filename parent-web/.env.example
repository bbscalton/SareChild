VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_R2_MEDIA_PROXY_BASE_URL=https://your-r2-proxy.workers.dev
# Optional override; defaults to ${VITE_R2_MEDIA_PROXY_BASE_URL}/platform-health (Cloudflare, no Blaze).
VITE_PLATFORM_HEALTH_URL=https://your-r2-proxy.workers.dev/platform-health
# Browser-restricted Google Maps key for Live Map, Static Maps thumbnails, and reverse-geocoding.
# Requires Maps JavaScript API, Maps Static API, and Geocoding API enabled on the key.
# Restrict by HTTP referrer in Google Cloud Console (Credentials), e.g.:
#   https://safechild-f34ac.web.app/*
#   http://107.170.15.179:8080/*
#   http://localhost:*
VITE_GOOGLE_MAPS_API_KEY=
# Optional comma-separated project owner emails/uids for the TCD parent-account admin table.
VITE_ADMIN_EMAILS=neuereatec@gmail.com
VITE_ADMIN_UIDS=

# WebRTC TURN (coturn on SareChild VPS) � required on restrictive NAT for live view
VITE_TURN_URL=turn:107.170.15.179:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=