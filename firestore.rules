rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function parentProfile() {
      return get(/databases/$(database)/documents/parentProfiles/$(request.auth.uid)).data;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isProjectAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches('(?i)^neuereatec@gmail.com$');
    }

    function requesterActive() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/parentProfiles/$(request.auth.uid))
          || (parentProfile().get('status', 'active') != 'purged'
            && parentProfile().get('status', 'active') != 'blocked'
            && parentProfile().get('adminBlocked', false) != true));
    }

    function isFamilyParent(familyId) {
      return requesterActive()
        && exists(/databases/$(database)/documents/parentProfiles/$(request.auth.uid))
        && parentProfile().get('familyId', '') == familyId;
    }

    function isFamilyOwner(familyId) {
      return requesterActive() && familyDoc(familyId).get('parentUid', '') == request.auth.uid;
    }

    function isFamilyGuardian(familyId) {
      return isFamilyParent(familyId)
        || (requesterActive()
          && exists(/databases/$(database)/documents/families/$(familyId)/guardians/$(request.auth.uid)));
    }

    function isDeviceMember(familyId, deviceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/devices/$(deviceId))
        && get(/databases/$(database)/documents/families/$(familyId)/devices/$(deviceId)).data.authUid
          == request.auth.uid;
    }

    // Per-device chat scoping: guardians must NOT see every device's conversation —
    // only the ones the parent has explicitly assigned them to via
    // devices/{deviceId}.assignedGuardianUids. The family owner always sees every thread.
    function deviceDoc(familyId, deviceId) {
      return get(/databases/$(database)/documents/families/$(familyId)/devices/$(deviceId)).data;
    }

    function isAssignedGuardian(familyId, deviceId) {
      return isFamilyGuardian(familyId)
        && request.auth.uid in deviceDoc(familyId, deviceId).get('assignedGuardianUids', []);
    }

    function canAccessDeviceChat(familyId, deviceId) {
      return isFamilyOwner(familyId)
        || isDeviceMember(familyId, deviceId)
        || isAssignedGuardian(familyId, deviceId);
    }

    match /parentProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isProjectAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['familyId', 'email'])
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.get('parentUid', '')
          == request.auth.uid;
      allow update: if isProjectAdmin()
        || (signedIn() && request.auth.uid == uid
        && (resource.data.get('status', 'active') != 'purged'
          || request.resource.data.get('status', 'active') == 'purged')
        && (resource.data.get('status', 'active') != 'blocked'
          && resource.data.get('adminBlocked', false) != true)
        && (!('trialEndsAt' in resource.data)
          || request.resource.data.trialEndsAt == resource.data.trialEndsAt)
        && (!('familyId' in resource.data)
          || request.resource.data.familyId == resource.data.familyId
          || (isFamilyGuardian(request.resource.data.familyId)
            && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)/guardians/$(request.auth.uid)))));
    }

    match /families/{familyId} {
      allow create: if requesterActive()
        && request.resource.data.get('parentUid', '') == request.auth.uid;
      allow read: if isFamilyGuardian(familyId) || isProjectAdmin();

      match /devices/{deviceId} {
        allow read: if isFamilyGuardian(familyId) || isDeviceMember(familyId, deviceId) || isProjectAdmin();
        allow create, update: if isFamilyGuardian(familyId)
          || (signedIn() && request.resource.data.authUid == request.auth.uid);

        match /installedApps/{packageName} {
          allow read: if isFamilyGuardian(familyId) || isDeviceMember(familyId, deviceId);
          allow create, update: if isDeviceMember(familyId, deviceId);
          allow delete: if isFamilyGuardian(familyId) || isDeviceMember(familyId, deviceId);
        }

        match /photos/{photoId} {
          allow read: if isFamilyGuardian(familyId);
          allow create, update: if isDeviceMember(familyId, deviceId);
          allow delete: if isFamilyGuardian(familyId) || isDeviceMember(familyId, deviceId);
        }

        match /activityEvents/{eventId} {
          allow read: if isFamilyGuardian(familyId);
          allow create, update: if isDeviceMember(familyId, deviceId);
          allow delete: if isFamilyGuardian(familyId) || isDeviceMember(familyId, deviceId);
        }

        // Per-device family chat thread — see canAccessDeviceChat() above. Only the
        // owner, this device's own child, or a guardian this device was assigned to
        // may read/send here (a caregiver guardian with no assignment gets nothing).
        match /chatMessages/{messageId} {
          allow read: if canAccessDeviceChat(familyId, deviceId);
          allow create: if canAccessDeviceChat(familyId, deviceId);
        }
      }

      match /alerts/{alertId} {
        allow read, update: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /familyChat/{messageId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow create: if isFamilyGuardian(familyId) || signedIn();
      }

      match /geofences/{geofenceId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /mapPlaces/{placeId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /commands/{commandId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow create: if isFamilyGuardian(familyId);
        allow update: if isFamilyGuardian(familyId) || signedIn();
      }

      match /appEvents/{eventId} {
        allow read: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /usageDaily/{dayId} {
        allow read: if isFamilyGuardian(familyId);
        allow create, update: if signedIn();
      }

      match /locationTrail/{sampleId} {
        allow read: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /callSmsPreviews/{previewId} {
        allow read: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /callRecordings/{recordingId} {
        allow read: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /whatsappEvents/{eventId} {
        allow read, delete: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /typingEvents/{eventId} {
        allow read, update: if isFamilyGuardian(familyId);
        allow create: if signedIn();
      }

      match /typingSafetySettings/{docId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /digests/{digestId} {
        allow read: if isFamilyGuardian(familyId);
        allow write: if false;
      }

      match /sosContacts/{contactId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /safeContacts/{contactId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /safetySettings/{docId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /appLimits/{limitId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /appBlockSchedules/{ruleId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /screenShareSchedules/{scheduleId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow write: if isFamilyGuardian(familyId);
      }

      match /liveSessions/{sessionId} {
        allow read: if isFamilyGuardian(familyId) || signedIn();
        allow create: if isFamilyGuardian(familyId);
        allow update: if isFamilyGuardian(familyId) || signedIn();
      }

      match /liveRecordings/{recordingId} {
        allow read, delete: if isFamilyGuardian(familyId);
        allow create: if isFamilyGuardian(familyId) || signedIn();
      }

      // Guardian membership is the crux of family isolation: whoever holds a
      // guardians/{uid} row can read the entire family (see isFamilyGuardian above).
      // Creation must therefore NEVER be self-service for an arbitrary familyId —
      // only the verified family owner (bootstrapping their own OWNER row, which is
      // only possible once families/{familyId}.parentUid already == their uid) or the
      // acceptGuardianInvite Cloud Function (Admin SDK, bypasses rules, validates a
      // real unexpired/unclaimed invite before writing) may create one. This closes
      // the 2026-08-05 cross-tenant isolation hole where any signed-in user could
      // grant themselves guardian/OWNER access to any family by id.
      match /guardians/{uid} {
        allow read: if isFamilyGuardian(familyId) || isProjectAdmin();
        allow create: if isFamilyOwner(familyId) || isProjectAdmin();
        // Self-updates may only touch chat-presence fields (chatOnline/lastSeenMs) —
        // role/email/joinedAtMs are immutable outside the owner/admin/invite paths.
        allow update: if isFamilyOwner(familyId) || isProjectAdmin()
          || (requesterActive() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.joinedAtMs == resource.data.joinedAtMs);
        allow delete: if isFamilyOwner(familyId) || isProjectAdmin() || (requesterActive() && request.auth.uid == uid);
      }
    }

    match /guardianInvites/{code} {
      allow read: if signedIn();
      allow create: if isFamilyOwner(request.resource.data.familyId);
      // Claiming (marking used + writing the guardians/{uid} row) happens exclusively
      // via the acceptGuardianInvite Cloud Function, which uses Admin SDK privileges
      // and therefore isn't subject to these rules. No client write path exists here
      // on purpose — see the guardians/{uid} rule above for why.
      allow update: if isFamilyOwner(request.resource.data.familyId) || isProjectAdmin();
    }

    match /pairingCodes/{code} {
      allow read: if signedIn();
      allow create: if requesterActive()
        && isFamilyGuardian(request.resource.data.familyId);
      allow update: if signedIn();
    }

    match /keywordLists/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /liveViewQuota/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isProjectAdmin());
      allow create, update: if signedIn() && (request.auth.uid == uid || isProjectAdmin());
    }

    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow write: if isProjectAdmin();
    }

    match /adminFeatureOverrides/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isProjectAdmin());
      allow write: if isProjectAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isProjectAdmin();
      allow create: if isProjectAdmin();
      allow update, delete: if false;
    }

    // Reseller program — balances and vouchers mutate only via Cloud Functions.
    match /resellers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isProjectAdmin());
      allow write: if false;
    }

    match /resellerLedger/{entryId} {
      allow read: if isProjectAdmin()
        || (signedIn() && resource.data.resellerUid == request.auth.uid);
      allow write: if false;
    }

    match /vouchers/{code} {
      allow read: if isProjectAdmin()
        || (signedIn() && resource.data.createdByResellerUid == request.auth.uid);
      allow write: if false;
    }
  }
}
