# Only needed to run the standalone TCD console (tcd.html) locally with `npm run dev`.
# The plain marketing landing page (index.html) needs none of these. In CI these are
# populated from the same repo secrets already used by the parent-web Firebase Hosting
# build (see .github/workflows/deploy-marketing-pages.yml).
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_R2_MEDIA_PROXY_BASE_URL=https://sarechild-media-proxy.neuereatec.workers.dev
VITE_PLATFORM_HEALTH_URL=
VITE_FUNCTIONS_HEALTH_URL=
VITE_PARENT_WEB_URL=https://safechild-f34ac.web.app/
VITE_MARKETING_URL=https://bbscalton.github.io/SareChild/
