# Loaded automatically by Firebase CLI on `firebase deploy --only functions`.
# Copy to `.env` (gitignored) and set a strong random value.
#
# Must match the Cloudflare Worker secret MEDIA_PURGE_SECRET on sarechild-media-proxy
# (wrangler secret put MEDIA_PURGE_SECRET --name sarechild-media-proxy).
# Used by deletePairedDevice and purgeExpiredRetentionData to call DELETE /prefix/…
# and POST /edge/purge/device on the R2 media proxy.
R2_MEDIA_PURGE_SECRET=

# Optional: DigitalOcean personal access token so TCD Storage can show droplet
# size / region / status for 107.170.15.179 (read droplets).
DO_API_TOKEN=
VPS_HOST=107.170.15.179

# Windows PC XAMPP archive (C:\xampp2\htdocs\sarechild-storage).
# Must be a public HTTPS URL (Cloudflare Tunnel). Never http://127.0.0.1 —
# Cloud Functions cannot see the user's PC loopback. Match pc-storage/.secret.
XAMPP_STORAGE_URL=
XAMPP_STORAGE_SECRET=
