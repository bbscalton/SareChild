<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloud_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_camera_friendly"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Camera safety check"
            android:textAppearance="@style/TextAppearance.SareChild.Title"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Take a photo to send to your parent. You'll always see it before it sends."
            android:textColor="@color/ink_soft" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SareChild.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:contentPadding="0dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/sky_soft"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureBack"
                style="@style/Widget.SareChild.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureFront"
                style="@style/Widget.SareChild.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Front camera" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture"
            style="@style/Widget.SareChild.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Take photo (default)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send"
            style="@style/Widget.SareChild.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="Send to parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel"
            style="@style/Widget.SareChild.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
