<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SareChild" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sky_blue</item>
        <item name="colorOnPrimary">@color/cloud_white</item>
        <item name="colorPrimaryContainer">@color/sky_soft</item>
        <item name="colorOnPrimaryContainer">@color/sky_blue_dark</item>
        <item name="colorSecondary">@color/sunny_yellow_dark</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/sun_soft</item>
        <item name="colorTertiary">@color/coral</item>
        <item name="colorOnTertiary">@color/cloud_white</item>
        <item name="colorSurface">@color/cloud_white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="android:colorBackground">@color/cloud_bg</item>
        <item name="colorError">@color/coral_dark</item>
        <item name="android:statusBarColor">@color/sky_blue_dark</item>
        <item name="android:navigationBarColor">@color/cloud_white</item>
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="materialButtonStyle">@style/Widget.SareChild.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.SareChild.Card</item>
    </style>

    <!-- Typography: rounded display font for headings, plain readable font for body copy. -->
    <style name="TextAppearance.SareChild.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.SareChild.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.SareChild.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="TextAppearance.SareChild.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.SareChild.CountdownNumber" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Big, friendly pill-shaped buttons -->
    <style name="Widget.SareChild.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">30dp</item>
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.SareChild.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">30dp</item>
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.SareChild.Button.Danger" parent="Widget.Material3.Button">
        <item name="cornerRadius">30dp</item>
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="backgroundTint">@color/coral</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <!-- Rounded, friendly cards used across every screen -->
    <style name="Widget.SareChild.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/cloud_white</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Widget.SareChild.Card.Soft" parent="Widget.SareChild.Card">
        <item name="cardElevation">0dp</item>
    </style>
</resources>
